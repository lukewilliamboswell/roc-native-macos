# Built by scripts/build.roc (the glue in host/ is committed)
platform/targets/arm64mac/libhost.a
platform/targets/arm64mac/libhost.fingerprint
platform/targets/x64mac/libhost.a
platform/targets/x64mac/libhost.fingerprint
platform/targets/x64v1mac/libhost.a
platform/targets/macos-sysroot/
# Example binaries and their .app bundles (examples/<name>/<name>.app); their
# sources and assets/ stay tracked
examples/*/*
examples/*/*.app/
!examples/*/*.roc
!examples/*/*.md
!examples/*/assets/
# Each app's tests: tests/specs/, tests/fixtures/ and the starter's tests/fuzz/
!examples/*/tests/
# The starter's app and logic package (examples/starter)
!examples/*/src/
!examples/*/logic/
# The bench harnesses' binaries (bench/<name>/<name>), beside their sources
bench/*/*
!bench/*/*.roc
!bench/*/*.adoc
!bench/*/*.sh
!bench/*/src/
!bench/*/tests/

# Blueprint's generated environment and links
.blueprint/

# Local agent state and worktrees
.claude/

# scripts/bundle.roc: the bundle, its staging tree and its consumer test
build/

# roc-docs output, from building the manual locally
.docs-out/

# macOS Finder metadata
.DS_Store
