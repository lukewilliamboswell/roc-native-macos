# The `macos.roc` tool: create, build, run and test a roc-native-macos app.
# Each release bundles this package with the counter scaffold and its
# platform's URL (`Bundle.roc`, generated by scripts/release.roc), and
# publishes a small `macos.roc` app that runs it.
package
	[MacOS]
	{
		cli: platform "https://github.com/roc-lang/basic-cli/releases/download/0.28.1/7brgwR8YUqfeGrkdfF1V4GPPN7DnP7ftqub9KcrTEZtr.tar.zst",
		zip: "https://github.com/lukewilliamboswell/roc-zip/releases/download/0.3.0-rc4/7KtXa6LGYfVGZK5kDMtkHeumUJywvSR15YdQoRvfzxg1.tar.zst",
	}
