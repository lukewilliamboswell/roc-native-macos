## The engine facades: `platform/{Engine,Layout,Wire,Worker}.roc`, which
## re-expose the roc-signals engine package's modules of the same names as
## the platform's own, so an app keeps writing `import pf.Engine`. A
## platform cannot list a package's module in its `exposes`, so each facade
## aliases every type and forwards every value of the package module's
## block, with the doc comment above it. `scripts/build.roc -- engine`
## writes them from the package `platform/main.roc` names, and the check's
## `engine` stage requires the committed ones to be what it writes.
Facade := [].{

	## The package modules the platform re-exposes, in `exposes` order.
	modules : List(Str)
	modules = ["Engine", "Layout", "Wire", "Worker"]

	## The engine package's URL: the `engine:` entry of the platform root's
	## `packages`.
	package_url : Str -> Try(Str, [NoPackage])
	package_url = |root|
		match root.split_on("engine: \"") {
			[_, rest, ..] =>
				match rest.split_on("\"") {
					[url, ..] if url.starts_with("https://") and url.ends_with(".tar.zst") => Ok(url)
					_ => Err(NoPackage)
				}
			_ => Err(NoPackage)
		}

	## The facade of the package module `name`, whose source is `source`:
	## every member of its `name := [].{ ... }` block, a type as an alias of
	## the package's and a value as the package's, each under its doc
	## comment. A value's annotation and definition are one member.
	source_of : Str, Str, Str -> Try(Str, [NoBlock(Str)])
	source_of = |name, source, url| {
		lines = source.split_on("\n")
		opening = "${name} := [].{"
		block = match lines.find_first_index(|line| line == opening) {
			Ok(index) => lines.drop_first(index + 1)
			Err(_) => return Err(NoBlock(name))
		}
		var $members = []
		var $seen = []
		var $doc = []
		for line in block {
			if line == "}" {
				break
			}
			if line.starts_with("\t##") {
				$doc = $doc.append(line)
			} else {
				match Facade.member(line) {
					Ok(Type(declared)) => {
						$members = $members.append($doc.append("\t${declared} : Upstream.${declared}"))
					}
					Ok(Value(value)) =>
						if !$seen.contains(value) {
							$seen = $seen.append(value)
							$members = $members.append($doc.append("\t${value} = Upstream.${value}"))
						}
					Err(NotAMember) => {}
				}
				$doc = []
			}
		}
		header = [
			"import engine.${name} as Upstream",
			"",
			"## Generated by `blueprint run build -- engine`: do not edit. roc-signals'",
			"## `${name}`, from the engine package",
			"## ${url},",
			"## re-exposed as the platform's own (`scripts/src/Facade.roc`).",
			"${name} := [].{",
			"",
		]
		body = $members.map(|lines_of| Str.join_with(lines_of, "\n"))
		Ok("${Str.join_with(header, "\n")}\n${Str.join_with(body, "\n\n")}\n}\n")
	}

	## What a line one tab into the block declares: a type with its
	## parameters (`Cell(st, a)`), or a value's name (`cell`, `work!`).
	member : Str -> Try([Type(Str), Value(Str)], [NotAMember])
	member = |line| {
		if !line.starts_with("\t") or line.starts_with("\t\t") or line.starts_with("\t ") {
			return Err(NotAMember)
		}
		text = line.drop_prefix("\t")
		by_colon = text.split_on(" :").first() ?? text
		by_equals = text.split_on(" =").first() ?? text
		declared = if (by_colon.count_utf8_bytes() < by_equals.count_utf8_bytes()) by_colon else by_equals
		if declared == text {
			Err(NotAMember)
		} else if Facade.type_head(declared) {
			Ok(Type(declared))
		} else if Facade.value_name(declared) {
			Ok(Value(declared))
		} else {
			Err(NotAMember)
		}
	}

	## `Name` or `Name(a, b)`: an uppercase name with closed parameters.
	type_head : Str -> Bool
	type_head = |text|
		match text.to_utf8() {
			[first, ..] if first >= 'A' and first <= 'Z' =>
				!text.contains("(") or (text.ends_with(")") and !text.contains("{") and !text.contains("["))
			_ => Bool.False
		}

	## A lowercase name, possibly ending in `!`.
	value_name : Str -> Bool
	value_name = |text|
		match text.to_utf8() {
			[first, ..] if first >= 'a' and first <= 'z' => text.to_utf8().all(|c| (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '!')
			_ => Bool.False
		}
}

expect Facade.package_url("\tpackages { engine: \"https://x.invalid/engine-A.tar.zst\" }\n") == Ok("https://x.invalid/engine-A.tar.zst")
expect Facade.package_url("\tpackages { cbor: \"https://x.invalid/c.tar.zst\" }\n") == Err(NoPackage)

expect Facade.member("\tCell(st, a) : EngineCell(st, a)") == Ok(Type("Cell(st, a)"))
expect Facade.member("\tCells(whole, st, h) :: { d : Core.Cells(whole, st, h) }.{") == Ok(Type("Cells(whole, st, h)"))
expect Facade.member("\twork! : Engine.Program(st) => List(U8)") == Ok(Value("work!"))
expect Facade.member("\tevery_row = { start: 0, count: U64.highest }") == Ok(Value("every_row"))
expect Facade.member("\t\tnested = 1") == Err(NotAMember)
expect Facade.member("\t# a comment") == Err(NotAMember)
expect Facade.member("") == Err(NotAMember)

facade_source : Str
facade_source =
	\\import Core
	\\
	\\Thing := [].{
	\\
	\\	## A cell.
	\\	Cell(st, a) : Core.Cell(st, a)
	\\
	\\	## Make one.
	\\	## Twice documented.
	\\	cell : a -> Cell(st, a)
	\\	cell = |init| Core.cell(init)
	\\
	\\	helper = 1
	\\}
	\\
	\\Other := [A].{
	\\	ignored = 2
	\\}
	\\

facade_expected : Str
facade_expected =
	\\import engine.Thing as Upstream
	\\
	\\## Generated by `blueprint run build -- engine`: do not edit. roc-signals'
	\\## `Thing`, from the engine package
	\\## https://x.invalid/e.tar.zst,
	\\## re-exposed as the platform's own (`scripts/src/Facade.roc`).
	\\Thing := [].{
	\\
	\\	## A cell.
	\\	Cell(st, a) : Upstream.Cell(st, a)
	\\
	\\	## Make one.
	\\	## Twice documented.
	\\	cell = Upstream.cell
	\\
	\\	helper = Upstream.helper
	\\}
	\\

expect Facade.source_of("Thing", facade_source, "https://x.invalid/e.tar.zst") == Ok(facade_expected)

expect Facade.source_of("Missing", facade_source, "u") == Err(NoBlock("Missing"))
