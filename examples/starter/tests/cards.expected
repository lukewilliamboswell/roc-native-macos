--- 520x495
ui-vstack [1 views]
  ui-vstack [5 views]
    ui-hstack [2 views]
      ui-asset-image icon.png [1024x1024, 36pt wide, 36pt high]
      ui-text "Expenses" {text-style=large-title weight=bold}
    ui-form [1 views]
      ui-hstack [3 views]
        ui-text-field ""
        ui-dropdown "Food" of ["Food", "Transport", "Home", "Fun", "Other"]
        ui-button "Add"
    ui-vstack [1 views]
      ui-hstack [3 views]
        ui-text "Summary" {text-style=headline}
        ui-spacer
        ui-button "Show Summary"
    ui-vstack [2 views]
      ui-hstack [3 views]
        ui-text "Expenses" {text-style=headline}
        ui-spacer
        ui-button "Hide Expenses"
      ui-vstack [2 views]
        ui-hstack [3 views]
          ui-file-button "Import CSV…"
          ui-spacer
          ui-button "Clear All"
        ui-box {border=line:1:separator}
          ui-scroll [2 views, 238pt high]
            ui-hstack [5 views]
              ui-text "Cake"
              ui-spacer
              ui-text "Food" {color=secondary-label text-style=caption1}
              ui-text "4.00" {design=monospaced-digits}
              ui-button "Remove"
            ui-hstack [5 views]
              ui-text "Tea"
              ui-spacer
              ui-text "Food" {color=secondary-label text-style=caption1}
              ui-text "3.20" {design=monospaced-digits}
              ui-button "Remove"
    ui-text "Added Cake." {color=secondary-label text-style=callout}
