key cmd+n (heard)
key cmd+n (heard)
--- 560x519
ui-vstack [1 views]
  ui-vstack [4 views]
    ui-hstack [2 views]
      ui-image square.grid.2x2.fill
      ui-vstack [2 views]
        ui-text "Gallery" {text-style=title2 weight=semibold}
        ui-text "Native AppKit controls driven by the roc-signals engine" {color=secondary-label text-style=caption1}
    ui-vstack [2 views]
      ui-hstack [3 views]
        ui-spacer
        ui-segmented [Controls] Text Styles Shortcuts
        ui-spacer
      ui-vstack [4 views]
        ui-vstack [2 views]
          ui-text "CHOICE" {color=secondary-label text-style=subheadline weight=semibold}
          ui-box {border=line:1:separator}
            ui-vstack [2 views]
              ui-hstack [3 views]
                ui-image leaf.fill
                ui-text "Fruit"
                ui-dropdown "Cherry" of ["Apple", "Banana", "Cherry"]
              ui-text "You picked Cherry" {color=accent}
        ui-vstack [2 views]
          ui-text "LEVEL" {color=secondary-label text-style=subheadline weight=semibold}
          ui-box {border=line:1:separator}
            ui-vstack [2 views]
              ui-hstack [3 views]
                ui-image speaker.wave.2.fill
                ui-slider 40.0
                ui-text "40" {design=monospaced-digits}
              ui-progress 40/100
        ui-vstack [2 views]
          ui-text "RANGES" {color=secondary-label text-style=subheadline weight=semibold}
          ui-box {border=line:1:separator}
            ui-vstack [2 views]
              ui-hstack [3 views]
                ui-text "Gain"
                ui-slider -6.0
                ui-text "-6" {design=monospaced-digits}
              ui-hstack [3 views]
                ui-text "Zoom"
                ui-slider 200.0
                ui-text "200" {design=monospaced-digits}
        ui-vstack [2 views]
          ui-text "ACTIVITY" {color=secondary-label text-style=subheadline weight=semibold}
          ui-box {border=line:1:separator}
            ui-hstack [2 views]
              ui-checkbox "Working" [ ]
              ui-progress idle
    ui-shortcut
    ui-shortcut
