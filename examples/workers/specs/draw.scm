; Eight bands, each a job on the one worker thread, drawn in order.
(test "draw"
  (setup
    (worker-pool 1))
  (steps
    (choose "Fast")
    (click (button "Draw"))
    (await-work)
    (expect-workers :limit 1 :live 1 :running 0 :queued 0 :started 1 :answered 8 :lost 0 :stopped 0 :timed-out 0 :dropped 0)
    (expect-text (text "Drawn: 8 bands.") "Drawn: 8 bands.")
    (expect-dump (window :width 600 :height 504
                   (vstack :views 1
                     (vstack :views 2
                       (hstack :views 3
                         (text "Workers" :text-style title2 :weight semibold)
                         (spacer)
                         (text "Roc jobs off the main thread" :color secondary-label :text-style caption1))
                       (vstack :views 2
                         (hstack :views 3
                           (spacer)
                           (segmented :items ("Mandelbrot" "Lab") :selected "Mandelbrot")
                           (spacer))
                         (vstack :views 3
                           (hstack :views 6
                             (button "Draw")
                             (button "Cancel" :enabled #f)
                             (button "Zoom In")
                             (button "Reset")
                             (spacer)
                             (segmented :items ("Fast" "Fine" "Extreme") :selected "Fast"))
                           (hstack :views 3
                             (progress :value 8 :max 8)
                             (text "Drawn: 8 bands." :text-style callout)
                             (spacer))
