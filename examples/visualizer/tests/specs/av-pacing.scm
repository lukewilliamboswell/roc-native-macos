; Frame pacing of the twelve shaded presets, live: each drawn with Metal at
; the display's pace for three seconds at the full backing resolution of a
; window that nearly fills a MacBook Air's screen, while a song plays to the
; real output. It runs only with ROC_AV_TIMING=1 (and a Metal device), and
; reports each preset's frames, refreshes missed, frame time and GPU time
; on standard error (`av-timing:` lines) as well as judging them.
(test "av-pacing"
  (steps
    (require-av-timing)
    (require-metal)
    (renderer metal)
    (frame-clock display)
    (window-size 1400 860)
    (choose "Gallery")
    (files "../starter/assets/polymorphic-defunctionalization.mp3")
    (wait 1500)
    (choose "Liquid Drift")
    (wait 500)
    (mark-av-timing)
    (wait 3000)
    (expect-frame-pacing :dropped-at-most 9 :p99-at-most 34 :frames-at-least 150)
    (choose "Blur Corridor")
    (wait 500)
    (mark-av-timing)
    (wait 3000)
    (expect-frame-pacing :dropped-at-most 9 :p99-at-most 34 :frames-at-least 150)
